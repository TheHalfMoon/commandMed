    },
    {
      "target_id": "MODERN_MIDRANGE_ANDROID_REPRESENTATIVE",
      "device_class_identity": "Samsung_Galaxy_A56_5G_8GB",
      "os_family": "ANDROID",
      "resource_envelope": "8GB_RAM"
    },
    {
      "target_id": "LOW_RESOURCE_ANDROID_REPRESENTATIVE",
