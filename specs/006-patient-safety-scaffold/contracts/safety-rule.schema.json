{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commandmed.spec/006/safety-rule.schema.json",
  "title": "SafetyPolicy",
  "type": "object",
  "required": ["policy_version", "policy_sha256", "rules"],
  "properties": {
    "policy_version": { "type": "string", "minLength": 1 },
    "policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Canonical bundle identity: sha256(canonical_json({policy_version, rules})) computed over projection omitting policy_sha256 itself; validators must recompute by omitting this field per data-model §1.3" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/SafetyRule" },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SafetyRule": {
      "type": "object",
      "required": ["rule_id", "rule_version", "source_policy_sha256", "trigger_condition", "required_state", "precedence", "threshold_policy_class", "applicable_scope", "revoked"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 },
        "source_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "trigger_condition": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["lexical", "semantic_pattern", "tool_result_flag", "missing_slot", "evidence_state"] },
            "ref": { "type": "string" },
            "threshold": { "type": ["string", "number", "boolean", "null"] }
          },
          "additionalProperties": false
        },
        "required_state": { "enum": ["ANSWER", "ASK_MORE", "USE_TOOL", "RETRIEVE_EVIDENCE", "ABSTAIN", "ESCALATE", "EMERGENCY"] },
        "precedence": { "type": "integer", "minimum": 1, "maximum": 100 },
        "threshold_policy_class": { "enum": ["FROZEN_POLICY_ZERO_TOLERANCE", "FROZEN_SENTINEL_ZERO_VIOLATIONS", "PENDING_CLINICAL_EVIDENCE", "PENDING_FOUNDER_AND_CLINICAL_EVIDENCE", "NOT_APPLICABLE_TO_DECLARED_SCOPE"] },
        "applicable_scope": { "enum": ["SYSTEM_QUALIFICATION", "COMPONENT_QUALIFICATION"] },
        "revoked": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
