{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commandmed.spec/006/fixture-manifest.schema.json",
  "title": "FixtureManifest",
  "description": "Immutable manifest describing committed trace seals for offline fixture verification; trusted git commit OID is supplied out-of-band to verifier, not stored inside manifest",
  "type": "object",
  "required": ["manifest_version", "entries"],
  "properties": {
    "manifest_version": { "type": "string", "minLength": 1 },
    "manifest_identity_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Canonical content identity sha256(canonical_json({manifest_version, entries})) computed over projection omitting manifest_identity_sha256 itself" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["interaction_id", "seal_canonical_sha256", "expected_final_sequence", "terminal_record_sha256"],
        "properties": {
          "interaction_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          "seal_canonical_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256(canonical_json(trace_seal)) for this interaction_id" },
          "expected_final_sequence": { "type": "integer", "minimum": 0 },
          "terminal_record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
