{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commandmed.spec/006/fixture-manifest.schema.json",
  "title": "FixtureManifest",
  "description": "Immutable manifest anchoring committed trace seals for offline fixture verification; verification must be supplied a trusted manifest commit/tree hash out-of-band and reject if manifest does not match",
  "type": "object",
  "required": ["manifest_version", "manifest_commit_sha256", "entries"],
  "properties": {
    "manifest_version": { "type": "string", "minLength": 1 },
    "manifest_commit_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Trusted git tree or commit hash anchoring this manifest; verifier must be supplied this value independently and reject if computed manifest hash or current tree does not match" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["interaction_id", "seal_canonical_sha256", "expected_final_sequence", "terminal_record_sha256"],
        "properties": {
          "interaction_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          "seal_canonical_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256(canonical_json(trace_seal)) for this interaction_id" },
          "expected_final_sequence": { "type": "integer", "minimum": 0 },
          "terminal_record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
