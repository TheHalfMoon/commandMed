{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commandmed://spec007/research-component-scope-binding/v1",
  "title": "Spec007 ResearchComponentScopeBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "binding_sha256",
    "scope_id",
    "scope_class",
    "claim_class",
    "run_manifest_id",
    "run_manifest_sha256",
    "gradient_record_bindings",
    "sentinel_fixture_sha256s",
    "excluded_capability_ids",
    "required_guard_ids",
    "system_qualification_created",
    "clinical_qualification_created"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "binding_id": {"type": "string", "minLength": 1},
    "binding_sha256": {"$ref": "#/$defs/sha256"},
    "scope_id": {"const": "SPEC007_RESEARCH_ENGINEERING_COMPONENT_V1"},
    "scope_class": {"const": "COMPONENT_QUALIFICATION"},
    "claim_class": {"const": "NON_CLINICAL_RESEARCH_ENGINEERING_ONLY"},
    "run_manifest_id": {"type": "string", "minLength": 1},
    "run_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "gradient_record_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "content_scope_verification_sha256",
          "target_capability_ids",
          "optimization_feedback_allowed"
        ],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "content_scope_verification_sha256": {"$ref": "#/$defs/sha256"},
          "target_capability_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/admitted_capability"}
          },
          "optimization_feedback_allowed": {"const": true}
        }
      }
    },
    "sentinel_fixture_sha256s": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "excluded_capability_ids": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/excluded_capability"}
    },
    "required_guard_ids": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/guard_id"}
    },
    "system_qualification_created": {"const": false},
    "clinical_qualification_created": {"const": false}
  },
  "x-commandmed-cross-field-invariants": [
    {
      "id": "SELF_CONTENT_IDENTITY",
      "expression": "binding_sha256 == canonical_sha256(record excluding binding_sha256)",
      "enforcement": "REQUIRED_FAIL_CLOSED_VALIDATOR",
      "on_failure": "REJECT_BINDING"
    },
    {
      "id": "EXACT_RUN_MANIFEST_BINDING",
      "expression": "run_manifest_id and run_manifest_sha256 equal the exact supplied RunManifest identity/content",
      "enforcement": "REQUIRED_FAIL_CLOSED_VALIDATOR",
      "on_failure": "REJECT_BINDING"
    },
    {
      "id": "CONTENT_SCOPE_VERIFICATION_RESOLUTION",
      "expression": "every gradient binding resolves content_scope_verification_sha256 from the authoritative store and that record binds exact CurriculumRecord record_canonical_sha256/content_sha256 and exact target_capability_ids",
      "enforcement": "REQUIRED_FAIL_CLOSED_VALIDATOR",
      "on_failure": "REJECT_BINDING"
    },
    {
      "id": "SENTINEL_CONTENT_IDENTITY_RESOLUTION",
      "expression": "every sentinel_fixture_sha256 resolves one canonical content-addressed fixture and the seven resolved fixtures cover each frozen guard exactly once",
      "enforcement": "REQUIRED_FAIL_CLOSED_VALIDATOR",
      "on_failure": "REJECT_BINDING"
    },
    {
      "id": "EXACT_EXCLUDED_CAPABILITY_SET",
      "expression": "excluded_capability_ids == frozen SP007-RO-001 excluded capability set",
      "enforcement": "REQUIRED_FAIL_CLOSED_VALIDATOR",
      "on_failure": "REJECT_BINDING"
    },
    {
      "id": "EXACT_REQUIRED_GUARD_SET",
      "expression": "required_guard_ids == frozen SP007-RO-001 guard set",
      "enforcement": "REQUIRED_FAIL_CLOSED_VALIDATOR",
      "on_failure": "REJECT_BINDING"
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "admitted_capability": {
      "enum": [
        "GENERAL_INSTRUCTION_FOLLOWING",
        "GENERAL_ENGLISH_LANGUAGE",
        "GENERAL_ARABIC_LANGUAGE_NON_CLINICAL",
        "NON_CLINICAL_RESEARCH_LEARNING_FORMATTING",
        "UNCERTAINTY_AND_ABSTENTION",
        "SYNTHETIC_NON_CLINICAL_TOOL_ROUTING",
        "REPRODUCIBLE_TRAINING_CONTROL_MECHANICS",
        "PROVENANCE_QUARANTINE_CONTAMINATION_ENFORCEMENT",
        "GENERAL_CAPABILITY_PRESERVATION"
      ]
    },
    "excluded_capability": {
      "enum": [
        "PATIENT_SPECIFIC_DIAGNOSIS",
        "PATIENT_SPECIFIC_DIFFERENTIAL_DIAGNOSIS",
        "PATIENT_OR_CAREGIVER_TREATMENT_ADVICE",
        "PATIENT_OR_CAREGIVER_TRIAGE",
        "EMERGENCY_DISPOSITION_OR_REASSURANCE",
        "MEDICATION_OR_DOSE_RECOMMENDATION",
        "ALLERGY_OR_INTERACTION_ADVICE",
        "RENAL_HEPATIC_MEDICATION_ADVICE",
        "PREGNANCY_OR_PEDIATRIC_CLINICAL_ADVICE",
        "CLINICAL_PROFESSIONAL_DECISION_SUPPORT",
        "CLINICAL_WORKFLOW_RECOMMENDATION",
        "LAB_REPORT_CLINICAL_EXTRACTION_OR_INTERPRETATION",
        "PATIENT_FACING_EVIDENCE_SUMMARY",
        "MEDICAL_CITATION_SUPPORT_CLAIM",
        "ARABIC_CLINICAL_PARITY_CLAIM",
        "CLINICAL_SELECTIVE_RISK_OR_COVERAGE_CLAIM",
        "BENIGN_CASE_OVER_TRIAGE_CLAIM",
        "CLINICAL_SAFETY_RATE_CLAIM"
      ]
    },
    "guard_id": {
      "enum": [
        "RO_GUARD_001_OUT_OF_SCOPE_PATIENT_ADVICE",
        "RO_GUARD_002_OUT_OF_SCOPE_CLINICAL_PROFESSIONAL_ADVICE",
        "RO_GUARD_003_EMERGENCY_SENTINEL",
        "RO_GUARD_004_MEDICATION_SENTINEL",
        "RO_GUARD_005_DETERMINISTIC_TOOL_BOUNDARY",
        "RO_GUARD_006_UNSUPPORTED_CERTAINTY",
        "RO_GUARD_007_SCOPE_ESCAPE"
      ]
    }
  }
}
