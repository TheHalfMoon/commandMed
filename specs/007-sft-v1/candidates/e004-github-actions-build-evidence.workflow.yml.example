# E004 BUILD-EVIDENCE WORKFLOW SUBJECT.
# While stored outside .github/workflows this file is non-executable review material.
# It may be promoted only to the sole authorized live path under canonical Founder
# BUILD_ENVIRONMENT_DECISION_B, exact authority capture, and fresh exact-subject review.
# Presence at the live path does not itself authorize dispatch; canonical promotion,
# post-merge byte verification, and all pre-run conditions remain required.

name: E004 llama-quantize build evidence

on:
  workflow_dispatch:

permissions: {}

env:
  TOOL_REPOSITORY_URL: https://github.com/ggml-org/llama.cpp.git
  TOOL_COMMIT: c1d0e7a004015f23bc0233470b747b596f29b264
  TOOL_TREE: 2255f4747492109298a5c997f374d49c2af3113d
  GIT_TERMINAL_PROMPT: "0"
  GIT_CONFIG_NOSYSTEM: "1"
  GIT_ASKPASS: /bin/false
  SSH_ASKPASS: /bin/false

jobs:
  build-evidence:
    runs-on: ubuntu-24.04
    timeout-minutes: 30

    steps:
      - name: Fail-closed runner preflight
        shell: bash
        env:
          E004_HOME: ${{ runner.temp }}/e004-home
        run: |
          set -Eeuo pipefail

          required_tools=(
            bash env id git cmake ninja cc c++ python3 sha256sum readlink ldd file stat
            sudo unshare setpriv
          )
          for tool in "${required_tools[@]}"; do
            command -v "$tool" >/dev/null
          done

          mkdir -p "$E004_HOME"

          printf '%s\n' \
            "RUNNER_OS=${RUNNER_OS:-UNSET}" \
            "RUNNER_ARCH=${RUNNER_ARCH:-UNSET}" \
            "ImageOS=${ImageOS:-UNSET}" \
            "ImageVersion=${ImageVersion:-UNSET}"

          uname -a
          cat /etc/os-release
          git --version
          cmake --version
          ninja --version
          cc --version
          c++ --version
          python3 --version
          ldd --version
          sudo --version
          unshare --version
          setpriv --version

          for tool in bash env id git cmake ninja cc c++ python3 sudo unshare setpriv; do
            command_path="$(command -v "$tool")"
            resolved="$(readlink -f "$command_path")"
            printf '%s_command=%s\n%s_path=%s\n' "$tool" "$command_path" "$tool" "$resolved"
            sha256sum "$resolved"
          done

      - name: Materialize and verify exact public source
        shell: bash
        env:
          HOME: ${{ runner.temp }}/e004-home
          SOURCE_DIR: ${{ runner.temp }}/e004-llama.cpp
          BUILD_DIR: ${{ runner.temp }}/e004-llama.cpp-build
          SECURITY_EVIDENCE: ${{ runner.temp }}/e004-security-boundary.txt
        run: |
          set -Eeuo pipefail

          rm -rf "$SOURCE_DIR" "$BUILD_DIR"
          rm -f "$SECURITY_EVIDENCE"
          mkdir -p "$HOME"
          git init "$SOURCE_DIR"
          git -C "$SOURCE_DIR" remote add origin "$TOOL_REPOSITORY_URL"
          git -C "$SOURCE_DIR" \
            -c credential.helper= \
            -c http.extraHeader= \
            fetch --no-tags --depth=1 origin "$TOOL_COMMIT"
          git -C "$SOURCE_DIR" checkout --detach FETCH_HEAD

          actual_commit="$(git -C "$SOURCE_DIR" rev-parse HEAD)"
          actual_tree="$(git -C "$SOURCE_DIR" rev-parse 'HEAD^{tree}')"

          test "$actual_commit" = "$TOOL_COMMIT"
          test "$actual_tree" = "$TOOL_TREE"
          test -z "$(git -C "$SOURCE_DIR" status --porcelain)"

          printf '%s\n' \
            "TOOL_COMMIT=$actual_commit" \
            "TOOL_TREE=$actual_tree"

      - name: Configure and build with exact tools in isolated namespace
        shell: bash
        env:
          SOURCE_DIR: ${{ runner.temp }}/e004-llama.cpp
          BUILD_DIR: ${{ runner.temp }}/e004-llama.cpp-build
          E004_HOME: ${{ runner.temp }}/e004-home
          SECURITY_EVIDENCE: ${{ runner.temp }}/e004-security-boundary.txt
        run: |
          set -Eeuo pipefail

          # Resolve exact executable identities before crossing the privilege and
          # reset-env boundary.
          runner_uid="$(id -u)"
          runner_gid="$(id -g)"

          bash_command="$(command -v bash)"
          env_command="$(command -v env)"
          id_command="$(command -v id)"
          git_command="$(command -v git)"
          cmake_command="$(command -v cmake)"
          ninja_command="$(command -v ninja)"
          cc_command="$(command -v cc)"
          cxx_command="$(command -v c++)"
          python3_command="$(command -v python3)"
          sha256sum_command="$(command -v sha256sum)"
          readlink_command="$(command -v readlink)"
          sudo_command="$(command -v sudo)"
          unshare_command="$(command -v unshare)"
          setpriv_command="$(command -v setpriv)"

          bash_path="$(readlink -f "$bash_command")"
          env_path="$(readlink -f "$env_command")"
          id_path="$(readlink -f "$id_command")"
          git_path="$(readlink -f "$git_command")"
          cmake_path="$(readlink -f "$cmake_command")"
          ninja_path="$(readlink -f "$ninja_command")"
          cc_path="$(readlink -f "$cc_command")"
          cxx_path="$(readlink -f "$cxx_command")"
          python3_path="$(readlink -f "$python3_command")"
          sha256sum_path="$(readlink -f "$sha256sum_command")"
          readlink_path="$(readlink -f "$readlink_command")"
          sudo_path="$(readlink -f "$sudo_command")"
          unshare_path="$(readlink -f "$unshare_command")"
          setpriv_path="$(readlink -f "$setpriv_command")"

          # Preserve only original PATH directories needed by premeasured build
          # tools, in original precedence order.
          declare -A required_path_dirs=()
          for command_path in \
            "$bash_command" "$env_command" "$id_command" "$git_command" \
            "$cmake_command" "$ninja_command" "$cc_command" "$cxx_command" \
            "$python3_command" "$sha256sum_command" "$readlink_command"; do
            required_path_dirs["${command_path%/*}"]=1
          done

          build_path=""
          IFS=: read -r -a original_path_dirs <<< "$PATH"
          for dir in "${original_path_dirs[@]}"; do
            if [[ -n "$dir" && -n "${required_path_dirs[$dir]+present}" ]]; then
              if [[ -z "$build_path" ]]; then
                build_path="$dir"
              else
                build_path="$build_path:$dir"
              fi
            fi
          done
          test -n "$build_path"

          # Root privilege is used only to create the network namespace.
          # Privilege-boundary executables use exact absolute paths. setpriv
          # drops UID/GID, supplementary groups and capabilities, enables
          # no_new_privs, and resets inherited environment. PATH is then rebuilt
          # only from premeasured tool directories in original resolution order.
          "$sudo_path" -n "$unshare_path" --net -- \
            "$setpriv_path" \
              --reuid "$runner_uid" \
              --regid "$runner_gid" \
              --clear-groups \
              --inh-caps=-all \
              --ambient-caps=-all \
              --bounding-set=-all \
              --no-new-privs \
              --reset-env \
              -- \
            "$env_path" \
              HOME="$E004_HOME" \
              TMPDIR="$RUNNER_TEMP" \
              PATH="$build_path" \
              LC_ALL=C \
              LANG=C \
            "$bash_path" -Eeuo pipefail -c '
              source_dir="$1"
              build_dir="$2"
              expected_home="$3"
              expected_tmp="$4"
              expected_path="$5"
              security_evidence="$6"
              id_path="$7"
              env_path="$8"
              bash_path="$9"
              git_path="${10}"
              cmake_path="${11}"
              ninja_path="${12}"
              cc_path="${13}"
              cxx_path="${14}"
              python3_path="${15}"
              sha256sum_path="${16}"
              readlink_path="${17}"

              uid="$("$id_path" -u)"
              gid="$("$id_path" -g)"
              cap_inh=""
              cap_prm=""
              cap_eff=""
              cap_bnd=""
              cap_amb=""
              no_new_privs=""

              while read -r key value _; do
                case "$key" in
                  CapInh:) cap_inh="$value" ;;
                  CapPrm:) cap_prm="$value" ;;
                  CapEff:) cap_eff="$value" ;;
                  CapBnd:) cap_bnd="$value" ;;
                  CapAmb:) cap_amb="$value" ;;
                  NoNewPrivs:) no_new_privs="$value" ;;
                esac
              done < /proc/self/status

              test "$uid" != "0"
              test "$cap_inh" = "0000000000000000"
              test "$cap_prm" = "0000000000000000"
              test "$cap_eff" = "0000000000000000"
              test "$cap_bnd" = "0000000000000000"
              test "$cap_amb" = "0000000000000000"
              test "$no_new_privs" = "1"
              test "$HOME" = "$expected_home"
              test "$TMPDIR" = "$expected_tmp"
              test "$PATH" = "$expected_path"
              test "$LC_ALL" = "C"
              test "$LANG" = "C"

              sensitive_platform_env_present=NO
              while IFS="=" read -r name _; do
                case "$name" in
                  GITHUB_*|ACTIONS_*|RUNNER_*|GITHUB_TOKEN|GH_TOKEN)
                    sensitive_platform_env_present=YES
                    ;;
                esac
              done < <("$env_path")
              test "$sensitive_platform_env_present" = "NO"

              assert_resolution() {
                command_name="$1"
                expected="$2"
                command_path="$(command -v "$command_name")"
                test -n "$command_path"
                actual="$("$readlink_path" -f "$command_path")"
                test "$actual" = "$expected"
              }

              assert_resolution bash "$bash_path"
              assert_resolution env "$env_path"
              assert_resolution id "$id_path"
              assert_resolution git "$git_path"
              assert_resolution cmake "$cmake_path"
              assert_resolution ninja "$ninja_path"
              assert_resolution cc "$cc_path"
              assert_resolution c++ "$cxx_path"
              assert_resolution python3 "$python3_path"
              assert_resolution sha256sum "$sha256sum_path"
              assert_resolution readlink "$readlink_path"

              {
                printf "%s\n" \
                  "configure_build_uid=$uid" \
                  "configure_build_gid=$gid" \
                  "CapInh=$cap_inh" \
                  "CapPrm=$cap_prm" \
                  "CapEff=$cap_eff" \
                  "CapBnd=$cap_bnd" \
                  "CapAmb=$cap_amb" \
                  "NoNewPrivs=$no_new_privs" \
                  "HOME=$HOME" \
                  "TMPDIR=$TMPDIR" \
                  "PATH=$PATH" \
                  "LC_ALL=$LC_ALL" \
                  "LANG=$LANG" \
                  "sensitive_platform_env_present=$sensitive_platform_env_present" \
                  "build_bash_path=$bash_path" \
                  "build_env_path=$env_path" \
                  "build_id_path=$id_path" \
                  "build_git_path=$git_path" \
                  "build_cmake_path=$cmake_path" \
                  "build_ninja_path=$ninja_path" \
                  "build_cc_path=$cc_path" \
                  "build_cxx_path=$cxx_path" \
                  "build_python3_path=$python3_path"
                "$sha256sum_path" \
                  "$bash_path" "$env_path" "$id_path" "$git_path" \
                  "$cmake_path" "$ninja_path" "$cc_path" "$cxx_path" \
                  "$python3_path"
              } > "$security_evidence"

              "$cmake_path" \
                -S "$source_dir" \
                -B "$build_dir" \
                -G Ninja \
                -DCMAKE_BUILD_TYPE=Release \
                -DBUILD_SHARED_LIBS=OFF \
                -DLLAMA_BUILD_COMMON=ON \
                -DLLAMA_BUILD_TESTS=OFF \
                -DLLAMA_BUILD_TOOLS=ON \
                -DLLAMA_BUILD_EXAMPLES=OFF \
                -DLLAMA_BUILD_SERVER=OFF \
                -DLLAMA_BUILD_APP=OFF \
                -DLLAMA_BUILD_UI=OFF \
                -DLLAMA_USE_PREBUILT_UI=OFF \
                -DLLAMA_TOOLS_INSTALL=OFF \
                -DLLAMA_TESTS_INSTALL=OFF \
                -DLLAMA_OPENSSL=OFF \
                -DLLAMA_SUBPROCESS=OFF \
                -DLLAMA_LLGUIDANCE=OFF \
                -DGGML_NATIVE=OFF \
                -DGGML_CCACHE=OFF \
                -DGGML_OPENMP=OFF

              cmake_generator=""
              cmake_make_program=""
              cmake_c_compiler=""
              cmake_cxx_compiler=""
              while IFS="=" read -r key value; do
                case "$key" in
                  CMAKE_GENERATOR:*) cmake_generator="$value" ;;
                  CMAKE_MAKE_PROGRAM:*) cmake_make_program="$value" ;;
                  CMAKE_C_COMPILER:*) cmake_c_compiler="$value" ;;
                  CMAKE_CXX_COMPILER:*) cmake_cxx_compiler="$value" ;;
                esac
              done < "$build_dir/CMakeCache.txt"

              test "$cmake_generator" = "Ninja"
              test -n "$cmake_make_program"
              test -n "$cmake_c_compiler"
              test -n "$cmake_cxx_compiler"
              test "$("$readlink_path" -f "$cmake_make_program")" = "$ninja_path"
              test "$("$readlink_path" -f "$cmake_c_compiler")" = "$cc_path"
              test "$("$readlink_path" -f "$cmake_cxx_compiler")" = "$cxx_path"

              {
                printf "%s\n" \
                  "cmake_generator=$cmake_generator" \
                  "cmake_make_program=$cmake_make_program" \
                  "cmake_c_compiler=$cmake_c_compiler" \
                  "cmake_cxx_compiler=$cmake_cxx_compiler"
              } >> "$security_evidence"

              "$cmake_path" --build "$build_dir" \
                --target llama-quantize \
                --parallel 2 \
                --verbose
            ' _ \
              "$SOURCE_DIR" "$BUILD_DIR" "$E004_HOME" "$RUNNER_TEMP" "$build_path" "$SECURITY_EVIDENCE" \
              "$id_path" "$env_path" "$bash_path" "$git_path" "$cmake_path" "$ninja_path" \
              "$cc_path" "$cxx_path" "$python3_path" "$sha256sum_path" "$readlink_path"

          test -f "$SECURITY_EVIDENCE"
          cat "$SECURITY_EVIDENCE"
          printf 'SECURITY_EVIDENCE_SHA256='
          sha256sum "$SECURITY_EVIDENCE" | awk '{print $1}'

          sha256sum "$BUILD_DIR/CMakeCache.txt"
          sha256sum "$BUILD_DIR/compile_commands.json"

      - name: Emit build evidence to log only
        shell: bash
        env:
          SOURCE_DIR: ${{ runner.temp }}/e004-llama.cpp
          BUILD_DIR: ${{ runner.temp }}/e004-llama.cpp-build
          SECURITY_EVIDENCE: ${{ runner.temp }}/e004-security-boundary.txt
        run: |
          set -Eeuo pipefail

          binary="$BUILD_DIR/bin/llama-quantize"
          test -x "$binary"
          test -f "$SECURITY_EVIDENCE"

          binary_sha256="$(sha256sum "$binary" | awk '{print $1}')"
          binary_bytes="$(stat -c '%s' "$binary")"
          security_evidence_sha256="$(sha256sum "$SECURITY_EVIDENCE" | awk '{print $1}')"

          printf '%s\n' \
            "LLAMA_QUANTIZE_PATH=$binary" \
            "LLAMA_QUANTIZE_SHA256=$binary_sha256" \
            "LLAMA_QUANTIZE_BYTES=$binary_bytes" \
            "SECURITY_EVIDENCE_SHA256=$security_evidence_sha256"

          file "$binary"
          ldd "$binary" || true

          {
            printf '%s\n' \
              "tool_repository=$TOOL_REPOSITORY_URL" \
              "tool_commit=$(git -C "$SOURCE_DIR" rev-parse HEAD)" \
              "tool_tree=$(git -C "$SOURCE_DIR" rev-parse 'HEAD^{tree}')" \
              "runner_os=${RUNNER_OS:-UNSET}" \
              "runner_arch=${RUNNER_ARCH:-UNSET}" \
              "image_os=${ImageOS:-UNSET}" \
              "image_version=${ImageVersion:-UNSET}" \
              "configure_build_network_namespace=isolated" \
              "configure_build_privilege=unprivileged_no_new_privs_no_capabilities" \
              "security_evidence_sha256=$security_evidence_sha256" \
              "binary_sha256=$binary_sha256" \
              "binary_bytes=$binary_bytes"
            printf 'cmake_cache_sha256='
            sha256sum "$BUILD_DIR/CMakeCache.txt" | awk '{print $1}'
            printf 'compile_commands_sha256='
            sha256sum "$BUILD_DIR/compile_commands.json" | awk '{print $1}'
          } | tee "$RUNNER_TEMP/e004-build-evidence-manifest.txt"

          printf 'BUILD_EVIDENCE_MANIFEST_SHA256='
          sha256sum "$RUNNER_TEMP/e004-build-evidence-manifest.txt" | awk '{print $1}'

          # No upload/cache/release/package step is permitted.
